        /* =========================================================================
           4. PROCEDURAL WEB AUDIO ENGINE (5 REAL-TIME GENERATIVE CHANNELS)
        ========================================================================= */
        let audioCtx = null;
        let masterGain = null;
        let analyserNode = null;
        const channelNodes = {};

        function initAudioContext() {
            if (!audioCtx) {
                const AudioContextClass = window.AudioContext || window.webkitAudioContext;
                audioCtx = new AudioContextClass();
                masterGain = audioCtx.createGain();
                masterGain.gain.value = 0.85;

                analyserNode = audioCtx.createAnalyser();
                analyserNode.fftSize = 64;

                masterGain.connect(analyserNode);
                analyserNode.connect(audioCtx.destination);
            }
            if (audioCtx.state === 'suspended') {
                audioCtx.resume();
            }
        }

        // Helper: Create Pink Noise Buffer
        function createPinkNoiseBuffer(durationSec = 4) {
            const bufferSize = audioCtx.sampleRate * durationSec;
            const buffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
            const output = buffer.getChannelData(0);
            let b0 = 0, b1 = 0, b2 = 0, b3 = 0, b4 = 0, b5 = 0, b6 = 0;
            for (let i = 0; i < bufferSize; i++) {
                const white = Math.random() * 2 - 1;
                b0 = 0.99886 * b0 + white * 0.0555179;
                b1 = 0.99332 * b1 + white * 0.0750759;
                b2 = 0.96900 * b2 + white * 0.1538520;
                b3 = 0.86650 * b3 + white * 0.3104856;
                b4 = 0.55000 * b4 + white * 0.5329522;
                b5 = -0.7616 * b5 - white * 0.0168980;
                output[i] = b0 + b1 + b2 + b3 + b4 + b5 + b6 + white * 0.5362;
                output[i] *= 0.04;
                b6 = white * 0.115926;
            }
            return buffer;
        }

        function startChannelAudio(key) {
            initAudioContext();
            if (channelNodes[key]) return;

            const gain = audioCtx.createGain();
            gain.gain.setValueAtTime(0.001, audioCtx.currentTime);
            gain.gain.exponentialRampToValueAtTime(Math.max(0.01, state.audio[key].volume), audioCtx.currentTime + 0.5);
            gain.connect(masterGain);

            if (key === 'rain') {
                // 1) Rain outside viewport: Filtered Pink Noise
                const noise = audioCtx.createBufferSource();
                noise.buffer = createPinkNoiseBuffer(5);
                noise.loop = true;

                const lowpass = audioCtx.createBiquadFilter();
                lowpass.type = 'lowpass';
                lowpass.frequency.value = 950;

                const highpass = audioCtx.createBiquadFilter();
                highpass.type = 'highpass';
                highpass.frequency.value = 180;

                noise.connect(highpass);
                highpass.connect(lowpass);
                lowpass.connect(gain);
                noise.start();

                channelNodes[key] = {
                    gain,
                    stop: () => { try { noise.stop(); noise.disconnect(); } catch(e){} }
                };
            }
            else if (key === 'ship') {
                // 2) Starship Hum: Detuned low-frequency oscillators + slow LFO filter
                const osc1 = audioCtx.createOscillator();
                const osc2 = audioCtx.createOscillator();
                osc1.type = 'sawtooth';
                osc2.type = 'triangle';
                osc1.frequency.value = 55;   // A1
                osc2.frequency.value = 55.6; // Slight warm beating

                const filter = audioCtx.createBiquadFilter();
                filter.type = 'lowpass';
                filter.frequency.value = 135;

                const lfo = audioCtx.createOscillator();
                const lfoGain = audioCtx.createGain();
                lfo.frequency.value = 0.14;
                lfoGain.gain.value = 30;
                lfo.connect(lfoGain);
                lfoGain.connect(filter.frequency);

                const subGain = audioCtx.createGain();
                subGain.gain.value = 0.35;

                osc1.connect(filter);
                osc2.connect(filter);
                filter.connect(subGain);
                subGain.connect(gain);

                osc1.start();
                osc2.start();
                lfo.start();

                channelNodes[key] = {
                    gain,
                    stop: () => { try { osc1.stop(); osc2.stop(); lfo.stop(); } catch(e){} }
                };
            }
            else if (key === 'cat') {
                // 3) Space Cat Purring: ~26Hz fundamental + harmonic modulated by breathing LFO
                const carrier = audioCtx.createOscillator();
                carrier.type = 'sawtooth';
                carrier.frequency.value = 26.5;

                const filter = audioCtx.createBiquadFilter();
                filter.type = 'lowpass';
                filter.frequency.value = 150;

                const breathGain = audioCtx.createGain();
                breathGain.gain.value = 0.35;

                const breathLfo = audioCtx.createOscillator();
                breathLfo.type = 'sine';
                breathLfo.frequency.value = 0.38; // ~23 breaths/min cozy purr

                const breathDepth = audioCtx.createGain();
                breathDepth.gain.value = 0.25;

                breathLfo.connect(breathDepth);
                breathDepth.connect(breathGain.gain);

                carrier.connect(filter);
                filter.connect(breathGain);
                breathGain.connect(gain);

                carrier.start();
                breathLfo.start();

                channelNodes[key] = {
                    gain,
                    stop: () => { try { carrier.stop(); breathLfo.stop(); } catch(e){} }
                };
            }
            else if (key === 'fire') {
                // 4) Plasma Fireplace: Warm low hiss + procedural random crackle impulses
                const baseNoise = audioCtx.createBufferSource();
                baseNoise.buffer = createPinkNoiseBuffer(4);
                baseNoise.loop = true;

                const lp = audioCtx.createBiquadFilter();
                lp.type = 'lowpass';
                lp.frequency.value = 340;

                const hissGain = audioCtx.createGain();
                hissGain.gain.value = 0.5;

                baseNoise.connect(lp);
                lp.connect(hissGain);
                hissGain.connect(gain);
                baseNoise.start();

                // Random crackle generator interval
                const crackleTimer = setInterval(() => {
                    if (!audioCtx || !state.audio.fire.active) return;
                    if (Math.random() > 0.42) {
                        const popOsc = audioCtx.createOscillator();
                        const popGain = audioCtx.createGain();
                        const popFilter = audioCtx.createBiquadFilter();

                        popOsc.type = 'square';
                        popOsc.frequency.value = 700 + Math.random() * 1900;
                        popFilter.type = 'bandpass';
                        popFilter.frequency.value = 1200 + Math.random() * 1600;

                        const now = audioCtx.currentTime;
                        const amp = (0.04 + Math.random() * 0.12);
                        popGain.gain.setValueAtTime(0.001, now);
                        popGain.gain.exponentialRampToValueAtTime(amp, now + 0.004);
                        popGain.gain.exponentialRampToValueAtTime(0.0001, now + 0.025 + Math.random() * 0.03);

                        popOsc.connect(popFilter);
                        popFilter.connect(popGain);
                        popGain.connect(gain);

                        popOsc.start(now);
                        popOsc.stop(now + 0.06);
                    }
                }, 130);

                channelNodes[key] = {
                    gain,
                    stop: () => {
                        clearInterval(crackleTimer);
                        try { baseNoise.stop(); } catch(e){}
                    }
                };
            }
            else if (key === 'lofi') {
                // 5) Generative Lo-Fi Synth Chords (Warm electric piano / pad progressions)
                const chords = [
                    [174.61, 220.00, 261.63, 329.63, 392.00], // Fmaj9
                    [164.81, 196.00, 246.94, 293.66, 392.00], // Em7
                    [146.83, 174.61, 220.00, 261.63, 329.63], // Dm9
                    [130.81, 196.00, 246.94, 293.66, 329.63]  // Cmaj9
                ];
                let chordIdx = 0;

                const playChord = () => {
                    if (!audioCtx || !state.audio.lofi.active) return;
                    const freqs = chords[chordIdx % chords.length];
                    chordIdx++;
                    const now = audioCtx.currentTime;

                    const chordFilter = audioCtx.createBiquadFilter();
                    chordFilter.type = 'lowpass';
                    chordFilter.frequency.setValueAtTime(420, now);
                    chordFilter.frequency.exponentialRampToValueAtTime(860, now + 1.6);
                    chordFilter.frequency.exponentialRampToValueAtTime(360, now + 4.8);
                    chordFilter.connect(gain);

                    freqs.forEach((f, i) => {
                        const osc = audioCtx.createOscillator();
                        const noteGain = audioCtx.createGain();
                        osc.type = i % 2 === 0 ? 'triangle' : 'sine';
                        // Slight Lo-Fi tape detune
                        osc.frequency.value = f + (Math.random() * 1.4 - 0.7);

                        noteGain.gain.setValueAtTime(0.0001, now);
                        noteGain.gain.linearRampToValueAtTime(0.065, now + 0.85 + i * 0.08);
                        noteGain.gain.exponentialRampToValueAtTime(0.0001, now + 5.1);

                        osc.connect(noteGain);
                        noteGain.connect(chordFilter);

                        osc.start(now);
                        osc.stop(now + 5.2);
                    });
                };

                playChord();
                const chordInterval = setInterval(playChord, 4800);

                channelNodes[key] = {
                    gain,
                    stop: () => clearInterval(chordInterval)
                };
            }
        }

        function stopChannelAudio(key) {
            const node = channelNodes[key];
            if (!node) return;
            try {
                node.gain.gain.setTargetAtTime(0.0001, audioCtx.currentTime, 0.15);
            } catch (e) {}
            setTimeout(() => {
                node.stop();
                delete channelNodes[key];
            }, 260);
        }

        function toggleChannel(key) {
            state.audio[key].active = !state.audio[key].active;
            if (state.audio[key].active) {
                startChannelAudio(key);
            } else {
                stopChannelAudio(key);
            }
            renderAudioMixer();
        }

        function setChannelVolume(key, val) {
            const vol = parseFloat(val);
            state.audio[key].volume = vol;
            if (channelNodes[key] && audioCtx) {
                channelNodes[key].gain.gain.setTargetAtTime(Math.max(0.001, vol), audioCtx.currentTime, 0.05);
            }
            // Auto-activate if user drags slider while off
            if (!state.audio[key].active && vol > 0.02) {
                state.audio[key].active = true;
                startChannelAudio(key);
                renderAudioMixer();
            }
        }

        function toggleAllAudio() {
            const keys = Object.keys(state.audio);
            const anyActive = keys.some(k => state.audio[k].active);
            const targetState = !anyActive;

            keys.forEach(k => {
                state.audio[k].active = targetState;
                if (targetState) {
                    startChannelAudio(k);
                } else {
                    stopChannelAudio(k);
                }
            });
            renderAudioMixer();
        }

        function renderAudioMixer() {
            const container = document.getElementById('audio-channels-list');
            const dict = I18N[state.lang];
            const channelsMeta = [
                { key: 'rain', icon: 'cloud-rain' },
                { key: 'ship', icon: 'rocket' },
                { key: 'cat',  icon: 'cat' },
                { key: 'fire', icon: 'flame' },
                { key: 'lofi', icon: 'music' }
            ];

            container.innerHTML = '';
            let activeCount = 0;

            channelsMeta.forEach(({ key, icon }) => {
                const ch = state.audio[key];
                if (ch.active) activeCount++;

                const row = document.createElement('div');
                row.className = `rounded-2xl p-3.5 border transition-all ${ch.active ? 'bg-white/10 border-white/25' : 'bg-black/20 border-white/10'}`;
                row.innerHTML = `
                    <div class="flex items-center justify-between gap-3">
                        <div class="flex items-center gap-3 min-w-0">
                            <div class="w-9 h-9 rounded-xl flex items-center justify-center shrink-0 transition-colors" style="background: ${ch.active ? 'var(--accent-primary)' : 'rgba(255,255,255,0.07)'};">
                                <i data-lucide="${icon}" class="w-4 h-4 text-white"></i>
                            </div>
                            <div class="min-w-0">
                                <div class="text-xs sm:text-sm font-semibold text-white truncate">${dict[`ch_${key}_name`]}</div>
                                <div class="text-[11px] truncate" style="color: var(--text-muted);">${dict[`ch_${key}_desc`]}</div>
                            </div>
                        </div>
                        <button type="button" onclick="toggleChannel('${key}')" class="cosmic-toggle ${ch.active ? 'active' : ''}" aria-label="${dict[`ch_${key}_name`]}"></button>
                    </div>
                    <div class="mt-2.5 flex items-center gap-2.5 pl-12">
                        <i data-lucide="volume-1" class="w-3.5 h-3.5 shrink-0" style="color: var(--text-muted);"></i>
                        <input type="range" min="0" max="1" step="0.01" value="${ch.volume}"
                            oninput="setChannelVolume('${key}', this.value)"
                            class="cosmic-slider" aria-label="Volume">
                    </div>
                `;
                container.appendChild(row);
            });

            // Update Master Button & Status Text
            const masterLabel = document.getElementById('master-audio-label');
            const statusText = document.getElementById('audio-status-text');
            if (activeCount > 0) {
                masterLabel.textContent = dict.btn_audio_all_off;
                statusText.textContent = dict.audio_active.replace('{n}', activeCount);
                statusText.style.color = 'var(--text-main)';
            } else {
                masterLabel.textContent = dict.btn_audio_all_on;
                statusText.textContent = dict.audio_standby;
                statusText.style.color = 'var(--text-muted)';
            }

            lucide.createIcons();
        }

        // Subtle UI sound effects via Web Audio API
        function playSoftUiClick() {
            try {
                initAudioContext();
                const osc = audioCtx.createOscillator();
                const g = audioCtx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(520, audioCtx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(780, audioCtx.currentTime + 0.05);
                g.gain.setValueAtTime(0.04, audioCtx.currentTime);
                g.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + 0.06);
                osc.connect(g);
                g.connect(masterGain);
                osc.start();
                osc.stop(audioCtx.currentTime + 0.07);
            } catch (e) {}
        }

        function playCosmicChime() {
            try {
                initAudioContext();
                const notes = [523.25, 659.25, 783.99, 1046.50]; // C5 E5 G5 C6
                notes.forEach((freq, idx) => {
                    const osc = audioCtx.createOscillator();
                    const g = audioCtx.createGain();
                    osc.type = 'sine';
                    const start = audioCtx.currentTime + idx * 0.09;
                    osc.frequency.setValueAtTime(freq, start);
                    g.gain.setValueAtTime(0.001, start);
                    g.gain.linearRampToValueAtTime(0.08, start + 0.04);
                    g.gain.exponentialRampToValueAtTime(0.0001, start + 1.4);
                    osc.connect(g);
                    g.connect(masterGain);
                    osc.start(start);
                    osc.stop(start + 1.45);
                });
            } catch (e) {}
        }

        /* =========================================================================
           5. POMODORO ORBITAL TIMER
        ========================================================================= */
        function formatTime(sec) {
            const m = Math.floor(sec / 60).toString().padStart(2, '0');
            const s = (sec % 60).toString().padStart(2, '0');
            return `${m}:${s}`;
        }

        function updateTimerUI() {
            const total = state.timer.durations[state.timer.mode];
            const rem = state.timer.remaining;
            const formatted = formatTime(rem);

            document.getElementById('timer-display').textContent = formatted;
            document.getElementById('timer-status-badge').textContent = formatted;
            document.getElementById('timer-progress-bar').style.width = `${(rem / total) * 100}%`;

            document.querySelectorAll('.timer-mode-btn').forEach(btn => {
                const isCurrent = btn.getAttribute('data-timer-mode') === state.timer.mode;
                if (isCurrent) {
                    btn.style.background = 'var(--pill-active-bg)';
                    btn.style.color = '#ffffff';
                    btn.style.boxShadow = '0 0 12px var(--accent-glow)';
                } else {
                    btn.style.background = 'transparent';
                    btn.style.color = 'var(--text-muted)';
                    btn.style.boxShadow = 'none';
                }
            });
        }

        function setTimerMode(mode) {
            pauseTimer();
            state.timer.mode = mode;
            state.timer.remaining = state.timer.durations[mode];
            playSoftUiClick();
            updateTimerUI();
        }

        function startTimer() {
            if (state.timer.running) return;
            initAudioContext();
            state.timer.running = true;
            state.timer.intervalId = setInterval(() => {
                if (state.timer.remaining > 0) {
                    state.timer.remaining--;
                    updateTimerUI();
                } else {
                    pauseTimer();
                    playCosmicChime();
                    showCosmicToast();
                }
            }, 1000);
        }

        function pauseTimer() {
            state.timer.running = false;
            if (state.timer.intervalId) {
                clearInterval(state.timer.intervalId);
                state.timer.intervalId = null;
            }
        }

        function resetTimer() {
            pauseTimer();
            state.timer.remaining = state.timer.durations[state.timer.mode];
            playSoftUiClick();
            updateTimerUI();
        }

        function showCosmicToast() {
            const toast = document.getElementById('cosmic-toast');
            const dict = I18N[state.lang];
            document.getElementById('toast-title').textContent = dict.toast_timer_title;
            document.getElementById('toast-desc').textContent = dict.toast_timer_desc;

            toast.classList.remove('translate-y-24', 'opacity-0');
            setTimeout(() => {
                toast.classList.add('translate-y-24', 'opacity-0');
            }, 5000);
        }

        /* =========================================================================
           6. THEME & LANGUAGE SWITCHERS
        ========================================================================= */
        const CANVAS_THEME_COLORS = {
            midnight: {
                bg: '#090717',
                nebulas: ['rgba(124, 58, 237, 0.16)', 'rgba(56, 189, 248, 0.12)', 'rgba(192, 132, 252, 0.14)'],
                starTint: '#e9d5ff',
                meteor: '#a78bfa'
            },
            mars: {
                bg: '#17080d',
                nebulas: ['rgba(244, 63, 94, 0.16)', 'rgba(245, 158, 11, 0.13)', 'rgba(251, 113, 133, 0.14)'],
                starTint: '#ffe4e6',
                meteor: '#fb7185'
            },
            aurora: {
                bg: '#051412',
                nebulas: ['rgba(16, 185, 129, 0.16)', 'rgba(14, 165, 233, 0.14)', 'rgba(52, 211, 153, 0.13)'],
                starTint: '#d1fae5',
                meteor: '#34d399'
            }
        };

        function setTheme(themeKey) {
            state.theme = themeKey;
            document.body.setAttribute('data-theme', themeKey);

            document.querySelectorAll('.theme-btn').forEach(btn => {
                const active = btn.getAttribute('data-theme-btn') === themeKey;
                btn.style.background = active ? 'var(--pill-active-bg)' : 'transparent';
                btn.style.color = active ? '#ffffff' : 'var(--text-muted)';
            });
            playSoftUiClick();
        }

        function setLanguage(lang) {
            state.lang = lang;
            document.documentElement.lang = lang;
            const dict = I18N[lang];

            document.getElementById('app-title').textContent = dict.app_title;
            document.getElementById('app-subtitle').textContent = dict.app_subtitle;
            document.getElementById('live-badge').textContent = dict.live_badge;

            document.querySelectorAll('[data-i18n]').forEach(el => {
                const key = el.getAttribute('data-i18n');
                if (dict[key]) el.textContent = dict[key];
            });

            document.querySelectorAll('.lang-btn').forEach(btn => {
                const active = btn.getAttribute('data-lang-btn') === lang;
                btn.style.background = active ? 'var(--pill-active-bg)' : 'transparent';
                btn.style.color = active ? '#ffffff' : 'var(--text-muted)';
            });

            renderDrinkOptions();
            updateDrinkVisuals();
            renderAudioMixer();

            if (state.lastPredictionIdx >= 0) {
                document.getElementById('modal-prediction-text').textContent = `«${dict.predictions[state.lastPredictionIdx % dict.predictions.length]}»`;
            }
        }

        /* =========================================================================
           7. HTML5 CANVAS: STARFIELD, SHOOTING STARS, NEBULAE & AUDIO VISUALIZER
        ========================================================================= */
        const cosmosCanvas = document.getElementById('cosmos-canvas');
        const cCtx = cosmosCanvas.getContext('2d');
        let stars = [];
        let nebulas = [];
        let meteors = [];

        function resizeCosmosCanvas() {
            cosmosCanvas.width = window.innerWidth;
            cosmosCanvas.height = window.innerHeight;
            initCosmosEntities();
        }

        function initCosmosEntities() {
            const count = Math.min(180, Math.floor((cosmosCanvas.width * cosmosCanvas.height) / 9000));
            stars = Array.from({ length: count }, () => ({
                x: Math.random() * cosmosCanvas.width,
                y: Math.random() * cosmosCanvas.height,
                r: Math.random() * 1.6 + 0.4,
                alpha: Math.random(),
                speed: (Math.random() * 0.015 + 0.004) * (Math.random() > 0.5 ? 1 : -1),
                driftX: (Math.random() - 0.5) * 0.08
            }));

            nebulas = Array.from({ length: 4 }, (_, i) => ({
                x: Math.random() * cosmosCanvas.width,
                y: Math.random() * cosmosCanvas.height,
                r: Math.max(cosmosCanvas.width, cosmosCanvas.height) * (0.28 + Math.random() * 0.18),
                vx: (Math.random() - 0.5) * 0.22,
                vy: (Math.random() - 0.5) * 0.22,
                colorIdx: i % 3
            }));
        }

        function spawnMeteor() {
            meteors.push({
                x: Math.random() * cosmosCanvas.width * 1.1,
                y: Math.random() * cosmosCanvas.height * 0.45,
                len: 90 + Math.random() * 90,
                speed: 9 + Math.random() * 6,
                angle: Math.PI * 0.22 + (Math.random() * 0.1 - 0.05),
                life: 1.0
            });
        }

        function renderCosmosLoop() {
            const palette = CANVAS_THEME_COLORS[state.theme];
            cCtx.clearRect(0, 0, cosmosCanvas.width, cosmosCanvas.height);

            // 1. Floating Nebulae
            nebulas.forEach(n => {
                n.x += n.vx;
                n.y += n.vy;
                if (n.x < -n.r * 0.5 || n.x > cosmosCanvas.width + n.r * 0.5) n.vx *= -1;
                if (n.y < -n.r * 0.5 || n.y > cosmosCanvas.height + n.r * 0.5) n.vy *= -1;

                const grad = cCtx.createRadialGradient(n.x, n.y, 0, n.x, n.y, n.r);
                grad.addColorStop(0, palette.nebulas[n.colorIdx]);
                grad.addColorStop(1, 'rgba(0, 0, 0, 0)');
                cCtx.fillStyle = grad;
                cCtx.beginPath();
                cCtx.arc(n.x, n.y, n.r, 0, Math.PI * 2);
                cCtx.fill();
            });

            // 2. Twinkling Stars
            stars.forEach(s => {
                s.alpha += s.speed;
                if (s.alpha >= 1 || s.alpha <= 0.15) s.speed *= -1;
                s.x += s.driftX;
                if (s.x < 0) s.x = cosmosCanvas.width;
                if (s.x > cosmosCanvas.width) s.x = 0;

                cCtx.globalAlpha = Math.max(0.1, Math.min(1, s.alpha));
                cCtx.fillStyle = palette.starTint;
                cCtx.beginPath();
                cCtx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
                cCtx.fill();
            });
            cCtx.globalAlpha = 1;

            // 3. Occasional Shooting Stars
            if (Math.random() < 0.0045 && meteors.length < 2) {
                spawnMeteor();
            }

            for (let i = meteors.length - 1; i >= 0; i--) {
                const m = meteors[i];
                const dx = Math.cos(m.angle) * m.speed;
                const dy = Math.sin(m.angle) * m.speed;
                m.x -= dx;
                m.y += dy;
                m.life -= 0.016;

                if (m.life <= 0) {
                    meteors.splice(i, 1);
                    continue;
                }

                const tailX = m.x + Math.cos(m.angle) * m.len;
                const tailY = m.y - Math.sin(m.angle) * m.len;
                const grad = cCtx.createLinearGradient(m.x, m.y, tailX, tailY);
                grad.addColorStop(0, `rgba(255, 255, 255, ${m.life})`);
                grad.addColorStop(1, 'rgba(255, 255, 255, 0)');

                cCtx.strokeStyle = grad;
                cCtx.lineWidth = 2;
                cCtx.lineCap = 'round';
                cCtx.beginPath();
                cCtx.moveTo(m.x, m.y);
                cCtx.lineTo(tailX, tailY);
                cCtx.stroke();
            }

            renderSoundVisualizer();
            requestAnimationFrame(renderCosmosLoop);
        }

        // Audio Equalizer / Waveform Visualizer Canvas
        const visCanvas = document.getElementById('visualizer-canvas');
        const vCtx = visCanvas.getContext('2d');

        function renderSoundVisualizer() {
            if (!visCanvas) return;
            const rect = visCanvas.getBoundingClientRect();
            if (visCanvas.width !== Math.floor(rect.width) || visCanvas.height !== Math.floor(rect.height)) {
                visCanvas.width = Math.max(120, Math.floor(rect.width));
                visCanvas.height = Math.max(28, Math.floor(rect.height));
            }

            const w = visCanvas.width;
            const h = visCanvas.height;
            vCtx.clearRect(0, 0, w, h);

            const bars = 20;
            const barWidth = (w / bars) * 0.58;
            const gap = w / bars;
            const anyActive = Object.values(state.audio).some(c => c.active);

            let freqData = null;
            if (analyserNode && anyActive) {
                freqData = new Uint8Array(analyserNode.frequencyBinCount);
                analyserNode.getByteFrequencyData(freqData);
            }

            const accentColor = getComputedStyle(document.body).getPropertyValue('--accent-secondary').trim() || '#4cc9f0';
            vCtx.fillStyle = accentColor;

            for (let i = 0; i < bars; i++) {
                let amp = 0.12;
                if (anyActive && freqData) {
                    const raw = freqData[i % freqData.length] / 255;
                    const wave = Math.sin(Date.now() * 0.005 + i * 0.55) * 0.18 + 0.25;
                    amp = Math.max(0.16, Math.min(0.95, raw * 0.85 + wave));
                }
                const barH = Math.max(3, amp * h);
                const x = i * gap + (gap - barWidth) / 2;
                const y = (h - barH) / 2;

                vCtx.globalAlpha = anyActive ? 0.9 : 0.3;
                vCtx.beginPath();
                vCtx.roundRect(x, y, barWidth, barH, 3);
                vCtx.fill();
            }
            vCtx.globalAlpha = 1;
        }

        /* =========================================================================
           8. INITIALIZATION ON WINDOW LOAD
        ========================================================================= */
        window.addEventListener('resize', resizeCosmosCanvas);

        window.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closePredictionModal();
        });

        window.onload = function () {
            resizeCosmosCanvas();
            setTheme('midnight');
            setLanguage('ru');
            updateTimerUI();
            lucide.createIcons();
            renderCosmosLoop();
        };
    </script>
