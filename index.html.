<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Midnight Cosmic Coffee & Lo-Fi Radio</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Inter & Space Grotesk & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;600&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet">
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <style>
        :root {
            /* Default Theme: Midnight (Полночь) */
            --bg-primary: #090717;
            --bg-secondary: #120e2b;
            --accent-primary: #9d65ff;
            --accent-secondary: #4cc9f0;
            --accent-glow: rgba(157, 101, 255, 0.35);
            --card-bg: rgba(20, 16, 46, 0.52);
            --card-border: rgba(167, 139, 250, 0.22);
            --card-border-hover: rgba(167, 139, 250, 0.5);
            --text-main: #f3f0ff;
            --text-muted: #a59ec9;
            --pill-bg: rgba(255, 255, 255, 0.05);
            --pill-active-bg: rgba(157, 101, 255, 0.28);
            --slider-track: rgba(255, 255, 255, 0.14);
        }

        [data-theme="mars"] {
            /* Theme: Mars (Марс) */
            --bg-primary: #17080d;
            --bg-secondary: #2b1019;
            --accent-primary: #ff6b6b;
            --accent-secondary: #f9a826;
            --accent-glow: rgba(255, 107, 107, 0.35);
            --card-bg: rgba(42, 16, 25, 0.55);
            --card-border: rgba(255, 135, 135, 0.24);
            --card-border-hover: rgba(255, 135, 135, 0.52);
            --text-main: #fff1f2;
            --text-muted: #d4a3ad;
            --pill-bg: rgba(255, 255, 255, 0.05);
            --pill-active-bg: rgba(255, 107, 107, 0.28);
            --slider-track: rgba(255, 255, 255, 0.14);
        }

        [data-theme="aurora"] {
            /* Theme: Aurora (Сияние) */
            --bg-primary: #051412;
            --bg-secondary: #0b2622;
            --accent-primary: #10b981;
            --accent-secondary: #38bdf8;
            --accent-glow: rgba(16, 185, 129, 0.35);
            --card-bg: rgba(12, 36, 33, 0.54);
            --card-border: rgba(52, 211, 153, 0.24);
            --card-border-hover: rgba(52, 211, 153, 0.52);
            --text-main: #ecfdf5;
            --text-muted: #94c7ba;
            --pill-bg: rgba(255, 255, 255, 0.05);
            --pill-active-bg: rgba(16, 185, 129, 0.28);
            --slider-track: rgba(255, 255, 255, 0.14);
        }

        * {
            box-sizing: border-box;
            -webkit-tap-highlight-color: transparent;
        }

        html, body {
            margin: 0;
            padding: 0;
            width: 100%;
            min-height: 100vh;
            overflow-x: hidden;
            background-color: var(--bg-primary);
            color: var(--text-main);
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            transition: background-color 0.8s ease, color 0.6s ease;
        }

        .font-display {
            font-family: 'Space Grotesk', 'Inter', sans-serif;
        }

        .font-mono-num {
            font-family: 'JetBrains Mono', monospace;
            font-variant-numeric: tabular-nums;
        }

        /* Background Canvas */
        #cosmos-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            pointer-events: none;
        }

        /* Subtle Retro-Futuristic Scanline & Vignette Overlay */
        .space-overlay {
            position: fixed;
            inset: 0;
            z-index: 1;
            pointer-events: none;
            background: radial-gradient(circle at 50% 40%, transparent 45%, rgba(0, 0, 0, 0.48) 100%);
        }

        /* Glassmorphism Card */
        .glass-card {
            background: var(--card-bg);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            border: 1px solid var(--card-border);
            box-shadow: 0 12px 40px -10px rgba(0, 0, 0, 0.55), inset 0 1px 0 0 rgba(255, 255, 255, 0.08);
            transition: background 0.7s ease, border-color 0.35s ease, transform 0.3s ease, box-shadow 0.35s ease;
        }

        .glass-card:hover {
            border-color: var(--card-border-hover);
        }

        /* Custom Range Slider */
        input[type="range"].cosmic-slider {
            -webkit-appearance: none;
            appearance: none;
            width: 100%;
            height: 6px;
            background: var(--slider-track);
            border-radius: 999px;
            outline: none;
            cursor: pointer;
            transition: background 0.3s ease;
        }

        input[type="range"].cosmic-slider::-webkit-slider-thumb {
            -webkit-appearance: none;
            appearance: none;
            width: 18px;
            height: 18px;
            border-radius: 50%;
            background: var(--accent-primary);
            border: 2px solid #ffffff;
            box-shadow: 0 0 12px var(--accent-glow);
            cursor: pointer;
            transition: transform 0.15s ease, background-color 0.5s ease;
        }

        input[type="range"].cosmic-slider::-webkit-slider-thumb:hover {
            transform: scale(1.18);
        }

        input[type="range"].cosmic-slider::-moz-range-thumb {
            width: 18px;
            height: 18px;
            border-radius: 50%;
            background: var(--accent-primary);
            border: 2px solid #ffffff;
            box-shadow: 0 0 12px var(--accent-glow);
            cursor: pointer;
            transition: transform 0.15s ease, background-color 0.5s ease;
        }

        /* Toggle Switch */
        .cosmic-toggle {
            position: relative;
            width: 46px;
            height: 26px;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.12);
            border: 1px solid rgba(255, 255, 255, 0.15);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            cursor: pointer;
            flex-shrink: 0;
        }

        .cosmic-toggle::after {
            content: '';
            position: absolute;
            top: 2px;
            left: 2px;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            background: #e2e8f0;
            transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), background-color 0.3s ease;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.3);
        }

        .cosmic-toggle.active {
            background: var(--accent-primary);
            border-color: rgba(255, 255, 255, 0.4);
            box-shadow: 0 0 16px var(--accent-glow);
        }

        .cosmic-toggle.active::after {
            transform: translateX(20px);
            background: #ffffff;
        }

        /* Ingredient Pill */
        .ingredient-pill {
            background: var(--pill-bg);
            border: 1px solid rgba(255, 255, 255, 0.08);
            color: var(--text-muted);
            transition: all 0.25s ease;
        }

        .ingredient-pill:hover {
            background: rgba(255, 255, 255, 0.1);
            color: var(--text-main);
            transform: translateY(-1px);
        }

        .ingredient-pill.selected {
            background: var(--pill-active-bg);
            border-color: var(--accent-primary);
            color: #ffffff;
            box-shadow: 0 0 16px var(--accent-glow), inset 0 0 8px rgba(255, 255, 255, 0.08);
        }

        /* Primary Glow Button */
        .btn-cosmic-primary {
            background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
            color: #ffffff;
            box-shadow: 0 8px 25px -4px var(--accent-glow);
            transition: all 0.3s ease;
        }

        .btn-cosmic-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 30px -2px var(--accent-glow);
            filter: brightness(1.08);
        }

        .btn-cosmic-primary:active {
            transform: translateY(0);
        }

        /* Steam & Drink Animations */
        @keyframes steamRise1 {
            0% { transform: translateY(8px) scaleX(0.95); opacity: 0; }
            35% { opacity: 0.7; }
            75% { opacity: 0.35; }
            100% { transform: translateY(-28px) scaleX(1.12); opacity: 0; }
        }
        @keyframes steamRise2 {
            0% { transform: translateY(10px) scaleX(1.05); opacity: 0; }
            40% { opacity: 0.65; }
            80% { opacity: 0.25; }
            100% { transform: translateY(-32px) scaleX(0.9); opacity: 0; }
        }
        @keyframes starTwinkle {
            0%, 100% { opacity: 0.3; transform: scale(0.85); }
            50% { opacity: 1; transform: scale(1.25); }
        }
        @keyframes floatSlow {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-6px); }
        }

        .steam-path-1 { animation: steamRise1 3.4s infinite ease-in-out; }
        .steam-path-2 { animation: steamRise2 4.1s infinite ease-in-out 1.1s; }
        .steam-path-3 { animation: steamRise1 3.7s infinite ease-in-out 2.2s; }
        .drink-float { animation: floatSlow 5s infinite ease-in-out; }
        .stardust-sparkle { animation: starTwinkle 2.2s infinite ease-in-out; transform-origin: center; }

        /* Smooth transitions for SVG drink fills */
        .svg-layer-transition {
            transition: fill 0.65s ease, stop-color 0.65s ease, opacity 0.5s ease;
        }

        /* Modal Backdrop */
        .modal-backdrop {
            background: rgba(4, 3, 12, 0.78);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }

        /* Pulse Live Dot */
        @keyframes livePulse {
            0%, 100% { transform: scale(1); opacity: 1; }
            50% { transform: scale(1.45); opacity: 0.45; }
        }
        .live-dot {
            animation: livePulse 2s infinite ease-in-out;
        }
    </style>
</head>
